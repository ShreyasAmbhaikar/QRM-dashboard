# Database & Cache (PostgreSQL / Supabase & Redis)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qrm_dashboard?schema=public&connection_limit=10"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/qrm_dashboard"
REDIS_URL="redis://localhost:6379"

# NextAuth / Auth.js Authentication
NEXTAUTH_SECRET="development_secret_key_change_in_prod_32chars"
AUTH_SECRET="development_secret_key_change_in_prod_32chars"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NODE_ENV="development"
LOG_LEVEL="info"

# Public App URLs & Keys
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# Cloudflare Turnstile (Bot Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
CLOUDFLARE_TURNSTILE_SECRET=""

# Google OAuth Integration (Google Business Profile & Search Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI & Third-Party Integrations (Optional in Dev)
GROQ_API_KEY=""
CEREBRAS_API_KEY=""
GEMINI_API_KEY=""
RESEND_API_KEY=""
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Cloudflare R2 Storage (Media / Attachments)
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
